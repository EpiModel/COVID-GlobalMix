# symmetric home matrix in long format, rural, 10 age groups
avg.matrix.india.rural.home.10age.grps.prop <-
avg.matrices.india$avg.matrix.india.rural.10age.grps$avg.matrix.prop  %>% ungroup() %>% filter(predictor_contact == "Home") %>% select(`age`:`60+y`)  %>% pivot_longer(cols = `<6mo`:`60+y`, names_to = "vertical_age_grp", values_to = "degree") %>%
mutate(vertical_age_grp = factor(vertical_age_grp, levels= levels(india_contact$contact_age)
)
)
# symmetric non-home matrix in long format, rural, 10 age groups
avg.matrix.india.rural.nonhome.10age.grps.prop <-
avg.matrices.india$avg.matrix.india.rural.10age.grps$avg.matrix.prop  %>% ungroup() %>% filter(predictor_contact == "Nonhome") %>% select(`age`:`60+y`)  %>% pivot_longer(cols = `<6mo`:`60+y`, names_to = "vertical_age_grp", values_to = "degree")%>%
mutate(vertical_age_grp = factor(vertical_age_grp, levels= levels(india_contact$contact_age)
)
)
# symmetric home matrix in long format, rural, 6 age groups
avg.matrix.india.rural.home.6age.grps.prop <-
avg.matrices.india$avg.matrix.india.rural.6age.grps$avg.matrix.prop  %>% ungroup() %>% filter(predictor_contact == "Home") %>% select(`age`:`60+y`)  %>% pivot_longer(cols = `0-9y`:`60+y`, names_to = "vertical_age_grp", values_to = "degree") %>%
mutate(vertical_age_grp = factor(vertical_age_grp, levels= levels(india_mix$contact_age_reclass)
)
)
# symmetric non-home matrix in long format, rural, 6 age groups
avg.matrix.india.rural.nonhome.6age.grps.prop <-
avg.matrices.india$avg.matrix.india.rural.6age.grps$avg.matrix.prop  %>% ungroup() %>% filter(predictor_contact == "Nonhome") %>% select(`age`:`60+y`)  %>% pivot_longer(cols = `0-9y`:`60+y`, names_to = "vertical_age_grp", values_to = "degree")%>%
mutate(vertical_age_grp = factor(vertical_age_grp, levels= levels(india_mix$contact_age_reclass)
)
)
annotate_figure(
ggarrange(
symmetric_contactmatrix_viz(matrix_long = avg.matrix.india.rural.home.10age.grps.prop, max.degree = 1,
panel_title = "Home, Rural", metric = "prop")+
theme(axis.text.x=element_blank()),
symmetric_contactmatrix_viz(matrix_long = avg.matrix.india.rural.home.6age.grps.prop, max.degree = 1,
panel_title = "Home, Rural", metric = "prop")+
theme(axis.text.x=element_blank()),
symmetric_contactmatrix_viz(matrix_long = avg.matrix.india.rural.nonhome.10age.grps.prop, max.degree = 1,
panel_title = "Nonhome, Rural", metric = "prop"),
symmetric_contactmatrix_viz(matrix_long = avg.matrix.india.rural.nonhome.6age.grps.prop, max.degree = 1,
panel_title = "Nonhome, Rural", metric = "prop"),
ncol = 2, nrow = 2,
labels = c("A", "B", "C", "D"),
align = "h",
legend = "top",
common.legend = T
),
left = "Age",
bottom = "Age"
)
