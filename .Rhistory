# Duration of repeated contact by layer
india_mix %>%
filter( contact_location %in% c( "Nonhome",  "School",    "Work" )
& fromdayone == "Both days"
) %>%
group_by(study_site, contact_location, duration_contact) %>% summarize(n=n()) %>%
ggplot( mapping = aes(x = duration_contact,y = n)
)+
geom_col(aes(fill = contact_location) , position = position_dodge()
)+
facet_wrap(~study_site)+
theme_classic()+
geom_text(aes(label = n, group = contact_location),
colour = "black" ,  vjust = -0.2,position = position_dodge(0.8)
)+
labs(x = "", y = "", color = "contact_location")+theme(legend.position = "top")+
guides(fill=guide_legend(title=""))+
theme(plot.title = element_text(hjust = 0.5),
text = element_text(size=15)
)
list(# replicate the above analysis for contact on street
india_mix  %>% filter(study_site==nw[1]) %>%
filter( #contact_location %in% c( "Nonhome",  "School",    "Work" )
location_contact___6 ==1
& fromdayone == "Both days"
) %>%  group_by(frequency_contact, known_contact) %>%
tally() %>%
spread(frequency_contact,n),
india_mix  %>% filter(study_site==nw[2]) %>%
filter( #contact_location %in% c( "Nonhome",  "School",    "Work" )
location_contact___6 ==1
& fromdayone == "Both days"
) %>%  group_by(frequency_contact, known_contact) %>%
tally() %>%
spread(frequency_contact,n)
)%>%  kable() %>%  kableExtra::kable_classic(full_width = F, html_font = "Cambria")%>%
footnote(general = "The left, right tables are for the rural and urban networks, respectively.")
