)
assoc_btw_layers <- function(contact_count_wide){
output <-  list()
# Create degree category
output[[1]] <-
contact_count_wide <-
contact_count_wide %>% mutate(
Nonhome_cat = case_when(Nonhome==0 ~ "0",
Nonhome %in% c(1:2) ~ "1-2",
Nonhome %in% c(3:5) ~ "3-5",
Nonhome >=6 ~ "6+"),
Nonhome_cat = factor( Nonhome_cat),
Home_cat = case_when(Home==0 ~ "0",
Home %in% c(1:2) ~ "1-2",
Home %in% c(3:5) ~ "3-5",
Home >=6 ~ "6+"),
Home_cat = factor( Home_cat),
School_cat = case_when(School==0 ~ "0",
School %in% c(1:2) ~ "1-2",
School %in% c(3:5) ~ "3-5",
School >=6 ~ "6+"),
School_cat = factor( School_cat),
Work_cat = case_when(Work==0 ~ "0",
Work %in% c(1:2) ~ "1-2",
Work %in% c(3:5) ~ "3-5",
Work >=6 ~ "6+"),
Work_cat = factor( Work_cat),
)
# Assessing disperson of count of each layer (check with Sam to see if how overdispersion problem was handled in ARTnet)
output[[2]] <-
rbind(
contact_count_wide %>%
summarise_at(.vars = names(.)[3:6],
.funs = c(mean="mean")),
contact_count_wide %>%
summarise_at(.vars = names(.)[3:6],
.funs = c(variance="var"))
)
# Effect of non-home contact on home
glm_h_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Work_cat, data=., family = poisson(link=log)) %>% summary()
glm_h_sch <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ School_cat, data=., family = poisson(link=log))%>% summary()
glm_h_nh_sch_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Nonhome_cat + School_cat + Work_cat, data=., family = poisson(link=log))%>% summary()
output[[3]] <- rbind(glm_h_wk$coefficients, NA, glm_h_sch$coefficients, NA, glm_h_nh_sch_wk$coefficients)
names(output) <- c("df", "mean_variance", "glm_results")
}
assoc_btw_layers(contact_count_wide = contact_count_wide_rural)
