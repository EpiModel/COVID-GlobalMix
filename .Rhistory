contact_count_wide %>%
glm(Home~ School_cat, data=., family = poisson(link=log))
# Effects of other layers on Nonhome
output_model[[4]] <-
contact_count_wide %>%
glm(Nonhome~ Home_cat, data=., family = poisson(link=log))
output_model[[5]] <-
contact_count_wide %>%
glm(Nonhome~ School_cat , data=., family = poisson(link=log))
output_model[[6]] <-
contact_count_wide %>%
glm(Nonhome~ Work_cat , data=., family = poisson(link=log))
# Effects of other layers on School
output_model[[7]] <-
contact_count_wide %>%
glm(School~ Home_cat, data=., family = poisson(link=log))
output_model[[8]] <-
contact_count_wide %>%
glm(School~ Nonhome_cat , data=., family = poisson(link=log))
output_model[[9]] <-
contact_count_wide %>%
glm(School~ Work_cat , data=., family = poisson(link=log))
# Effects of other layers on work
output_model[[10]] <-
contact_count_wide %>%
glm(Work~ Home_cat, data=., family = poisson(link=log))
output_model[[11]] <-
contact_count_wide %>%
glm(Work~ School_cat , data=., family = poisson(link=log))
output_model[[12]] <-
contact_count_wide %>%
glm(Work~ Nonhome_cat , data=., family = poisson(link=log))
names(output_model) <- c(  "h_w", "h_nh", "h_s",
"nh_h", "nh_s", "nh_w",
"s_h", "s_nh", "s_w",
"w_h", "w_s", "w_nh")
if (output_type == "summary"){
output_model_summary <- rbind(c("h", rep(NA,3)),
summary(output_model[[1]])$coefficients %>% round(.,2),  summary(output_model[[2]])$coefficients %>% round(.,2) ,  summary(output_model[[3]])$coefficients %>% round(.,2)  ,
c("nh", rep(NA,3)),
summary(output_model[[4]])$coefficients %>% round(.,2) ,  summary(output_model[[5]])$coefficients %>% round(.,2) , summary(output_model[[6]])$coefficients %>% round(.,2) ,
c("s", rep(NA,3)),
summary(output_model[[7]])$coefficients %>% round(.,2) ,  summary(output_model[[8]])$coefficients %>% round(.,2) ,  summary(output_model[[9]])$coefficients %>% round(.,2) ,
c("w", rep(NA,3)),
summary(output_model[[10]])$coefficients %>% round(.,2) ,  summary(output_model[[11]])$coefficients %>% round(.,2) ,  summary(output_model[[12]])$coefficients %>% round(.,2) )
output_model_summary
} else if (output_type == "model") {
output_model
} else if (output_type == "data") { # categorized data
contact_count_wide
}
}
# Rural, Bivariate predictors, assessing bivariate association between layers
layer_rural_assoc_bi_data <- # outputting binarized contact data
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "data")
layer_rural_assoc_bi <- # outputting the bivariatemodeling result
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "model")
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "summary")[-c(2,4,6, 9,11,13, 16, 18, 20, 23, 25, 27),]
effect_oth_layers <-
function(
dta, # binarize contact degree of each layer
outcome_layer,
predict_layer
){
if(length(predict_layer)>1
){
# association between layers
layers_formula <- paste(outcome_layer, "~", paste(predict_layer[1], "+", predict_layer[2]))
layer_assoc <-
dta %>%
glm(layers_formula,
data=., family = poisson(link=log)
)
dta <- # a dataframe listing categories for the two predictive layer
data.frame( c(factor(0),factor(1)),  factor(1) )
#### proportion of degree == 1 and degree == 0 of the first predictive payer, given the degree in the second predictive layer ==1
prop.predictive.layer <- prop.table(table(
layer_rural_assoc_bi_data[predict_layer[1] # the first predictive layer
][layer_rural_assoc_bi_data[predict_layer[2]]==1]) # the second predictive layer ==1
)
} else{
# association between layers
layers_formula <- paste(outcome_layer, "~", predict_layer)
layer_assoc <-
dta %>%
glm(layers_formula,
data=., family = poisson(link=log)
)
dta <- # a dataframe listing categories for the single predictive layer
data.frame( c(factor(0), factor(1))  )
#### proportion of degree == 1 and degree == 0
prop.predictive.layer <- prop.table(table(
layer_rural_assoc_bi_data[predict_layer])
)
}
colnames(dta) <- predict_layer
outcome_predict <- # characterize the MD of outcome layers explained by the predictive layer
predict(layer_assoc, newdata = dta,
type = "response", interval = "confidence"
) %>% as.numeric()/2 # we add 2 here to covert the two-day MD to single-day MD
### Characterize target stats
N.predict.layer.degree <- prop.predictive.layer*1e4 # proportion of each category (0 and 1, sequentially)  of the 1st predictive ladder * total number of nodes in the sampled population = total number of nodes of each predictive category of the target population
targ.stat.outcome_predict_layers <- c(outcome_predict[1]* # correspond to the 0 category of the 1st predictive player
N.predict.layer.degree["0"],
outcome_predict[2]* # correspond to the 1 category of the 1st predictive player
N.predict.layer.degree["1"]
)
names(targ.stat.outcome_predict_layers) <- paste0(predict_layer[1] , names(targ.stat.outcome_predict_layers) )
targ.stat.outcome_predict_layers
}
