know_dur <- function(india_mix.){
known_dur_gt_10yr <- india_mix. %>% filter(known_contact == ">10 yrs" & contact_location %in% c( "School", "Work" )
) %>%
mutate(known_duration = (participant_ageyr - 10)/2)
#known_dur_gt_10yr %>% filter(known_duration<0) # participants w/ age < contact duration, discuss w/ Sam
known_dur_gt_10yr <-
known_dur_gt_10yr %>%
group_by(study_site, contact_location) %>%
summarize(known_contact_avg = mean(known_duration)*365) %>% ungroup()
known_duration <-
india_mix. %>%
filter(contact_location %in% c("School", "Work")) %>%
group_by(study_site, contact_location, frequency_contact, known_contact) %>%
tally() %>%
spread(frequency_contact,n) %>% data.frame() %>% rename(daily = Daily..almost.daily) %>%
select(study_site, contact_location, known_contact, daily ) %>%
filter(!is.na(known_contact)) %>% # filter out the empty category
ungroup() %>%
# characterize mid point for known duration for categories except >10yrs
mutate(know_contact_d = # median duration in days
case_when(known_contact=="Never met before" ~0,
known_contact=="<1 yr" ~182, # mid. point
known_contact=="1-2 yrs" ~ 548,# mid. point
known_contact=="3-5 yrs" ~ 1460,# mid. point
known_contact=="6-10 yrs" ~ 2922,# mid. point
# avg. midpoint of knowing the contacts, based on participant's age, for those having know the contacts for > 10yrs
known_contact==">10 yrs" & study_site == "Rural" & contact_location == "School" ~
known_dur_gt_10yr %>% filter( study_site == "Rural" & contact_location == "School") %>%
select(known_contact_avg) %>% as.numeric(),
known_contact==">10 yrs" & study_site == "Rural" & contact_location == "Work" ~
known_dur_gt_10yr %>% filter( study_site == "Rural" & contact_location == "Work") %>%
select(known_contact_avg) %>% as.numeric(),
known_contact==">10 yrs" & study_site == "Urban" & contact_location == "School" ~
known_dur_gt_10yr %>% filter( study_site == "Urban" & contact_location == "School") %>%
select(known_contact_avg) %>% as.numeric(),
known_contact==">10 yrs" & study_site == "Urban" & contact_location == "Work" ~
known_dur_gt_10yr %>% filter( study_site == "Urban" & contact_location == "Work") %>%
select(known_contact_avg) %>% as.numeric(),
)
) %>%
group_by(study_site, contact_location) %>%
mutate(
daily_prop = daily/sum(daily, na.rm = T), # proportion of daily contact,
weighted_known_contact_d = know_contact_d*daily_prop
) %>%   # The script until here create a data frame of the midpoint of known duration of contact and daily proportion
summarize(know_contact_duration_avg = sum(weighted_known_contact_d, na.rm = T)
) %>% ungroup()
}
known_duration <- know_dur(india_mix. = india_mix)
#saveRDS(known_duration, file = "~/Documents/GitHub/COVID-GlobalMix/data/network_params/known_dur_school_work.RData")
india_mix %>% filter(known_contact == ">10 yrs" & contact_location %in% c( "School", "Work" )
) %>%
mutate(known_duration = (participant_ageyr - 10)/2) %>% filter(known_duration<0) %>% select(participant_ageyr, known_contact, known_duration)
# Association between layer and household status, check with Sam
## Moses indicates that frequency_contact and known_contact were only surveyed for non-household contacts from participants. We check whether there are HH member having contact at school/work. There are 4 school/work and 58 nonhome contacts  of household members. Since these non-home (school, work, other non-home) contacts that are of household members, Billy thinks they can be re-classified as home contact.
# rural
# individual-level contact count at different locations by row
## data to wide format
contact_count_wide_rural  <-
contact_count_rural$contact_count %>% data.frame()%>%
tidyr::pivot_wider(names_from = "contact_location", values_from = "n_contacts"
) %>%  # 608 rows, each row for a participant
as.data.frame()
# urban
## data to wide format
contact_count_wide_urban  <-
contact_count_urban$contact_count %>% data.frame()%>%
tidyr::pivot_wider(names_from = "contact_location", values_from = "n_contacts"
) %>%  # 608 rows, each row for a participant
as.data.frame()
## spearman correlation,urban
contact_count_wide_urban %>% select(-c(rec_id, participant_age)) %>% ggpairs(upper = list(continuous = wrap("cor", method = "spearman")))
# spearman correlation,rural
## Count predictor
contact_count_wide_rural %>% select(-c(rec_id, participant_age)) %>% ggpairs(upper = list(continuous = wrap("cor", method = "spearman")
)
)
# Load libraries and data  ------------------------------------------------
lapply(c("ggpubr", "statnet", "EpiModel", "tidyverse", "socialmixr", "knitr",  "sjlabelled", "kableExtra", "broom", "stringr", "GGally"), require, character.only = TRUE)
# spearman correlation,rural
## Count predictor
contact_count_wide_rural %>% select(-c(rec_id, participant_age)) %>% ggpairs(upper = list(continuous = wrap("cor", method = "spearman")
)
)
assoc_btw_layers <- function(contact_count_wide){
output <-  list()
# Create degree category
output[[1]] <-
contact_count_wide <-
contact_count_wide %>% mutate(
Nonhome_cat = case_when(Nonhome==0 ~ "0",
Nonhome %in% c(1:2) ~ "1-2",
Nonhome %in% c(3:5) ~ "3-5",
Nonhome >=6 ~ "6+"),
Nonhome_cat = factor( Nonhome_cat),
Home_cat = case_when(Home==0 ~ "0",
Home %in% c(1:2) ~ "1-2",
Home %in% c(3:5) ~ "3-5",
Home >=6 ~ "6+"),
Home_cat = factor( Home_cat),
School_cat = case_when(School==0 ~ "0",
School %in% c(1:2) ~ "1-2",
School %in% c(3:5) ~ "3-5",
School >=6 ~ "6+"),
School_cat = factor( School_cat),
Work_cat = case_when(Work==0 ~ "0",
Work %in% c(1:2) ~ "1-2",
Work %in% c(3:5) ~ "3-5",
Work >=6 ~ "6+"),
Work_cat = factor( Work_cat),
)
# Assessing disperson of count of each layer (check with Sam to see if how overdispersion problem was handled in ARTnet)
output[[2]] <-
paste0(
contact_count_wide %>%
summarise_at(.vars = names(.)[3:6],
.funs = c(mean="mean")) %>% as.numeric() %>% round(.,2), " (",
contact_count_wide %>%
summarise_at(.vars = names(.)[3:6],
.funs = c(variance="var")) %>% as.numeric()%>% round(.,2),
")"
)
# Effect of non-home contact on home
glm_h_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Work_cat, data=., family = poisson(link=log)) %>% summary()
glm_h_sch <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ School_cat, data=., family = poisson(link=log))%>% summary()
glm_h_nh_sch_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Nonhome_cat + School_cat + Work_cat, data=., family = poisson(link=log))%>% summary()
output[[3]] <- rbind(glm_h_wk$coefficients, NA, glm_h_sch$coefficients, NA, glm_h_nh_sch_wk$coefficients)
names(output) <- c("df", "mean_variance", "glm_results")
output
}
assoc_btw_layers(contact_count_wide = contact_count_wide_rural)
