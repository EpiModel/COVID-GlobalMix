id_no_contact <-
india_participant %>%
filter(!(id %in% india_contact$id)) %>%
filter(study_site == site)
## Total number of contacts over two days
contact_count <-
data %>%
group_by(id, contact_location, fromdayone, .drop = F)%>% summarise(n_contacts = n()) %>% # summarizing number of contacts by type
ungroup() %>%
mutate(
n_contacts = case_when(
contact_location %in% c("Home", "Work","School") ~ n_contacts, # for these layers, a replicated contact is counted as unique contact
contact_location %in% c("Nonhome" ) & fromdayone == "Both days" ~ n_contacts*2, # for non-home layer, a replicated contact is counted as two contact
contact_location %in% c("Nonhome" ) & fromdayone %in% c("Day 1", "Day 2") ~ n_contacts, # for non-home layer, a unique contact is counted as one contact
T ~ n_contacts # for observation with fromdayone information missed, we return the original n_contacts
)
)%>%
group_by(id, contact_location, .drop = F) %>% summarise(n_contacts = sum(n_contacts)
) %>% ungroup() %>% # total number of contacts over two days
# add the participants w/o contact to the data
rbind(.,
data.frame(
id = rep(as.character(id_no_contact$id), each = length(locations)),
contact_location= rep(locations,
nrow(id_no_contact)
),
n_contacts=rep(0,  nrow(id_no_contact)*length(locations))
)
) %>%
# joining w/ participant's age
left_join(india_participant %>% select(id, participant_age),
by = "id"
)
contact_count <-
data %>%
group_by(id, contact_location, fromdayone, .drop = F)%>% summarise(n_contacts = n()) %>% # summarizing number of contacts by type
ungroup()
View(contact_count)
# Data processing
contact_freq <-
function(data, site, india_participant, india_contact){
locations <- levels(data$contact_location)
## participants having no contact
id_no_contact <-
india_participant %>%
filter(!(id %in% india_contact$id)) %>%
filter(study_site == site)
## Total number of contacts over two days
contact_count <-
data %>%
group_by(id, contact_location, fromdayone, .drop = F)%>% summarise(n_contacts = n()) %>% # summarizing number of contacts by type
ungroup() %>%
mutate(
n_contacts = case_when(
contact_location %in% c("Home", "Work","School") ~ n_contacts, # for these layers, a replicated contact is counted as unique contact
contact_location %in% c("Nonhome" ) & fromdayone == "Both days" ~ n_contacts*2, # for non-home layer, a replicated contact is counted as two contact
contact_location %in% c("Nonhome" ) & fromdayone %in% c("Day 1", "Day 2") ~ n_contacts, # for non-home layer, a unique contact is counted as one contact
T ~ n_contacts # for observation with fromdayone information missed, we return the original n_contacts
)
)%>%
group_by(id, contact_location, .drop = F) %>% summarise(n_contacts = sum(n_contacts)
) %>% ungroup() %>% # total number of contacts over two days
# add the participants w/o contact to the data
rbind(.,
data.frame(
id = rep(as.character(id_no_contact$id), each = length(locations)),
contact_location= rep(locations,
nrow(id_no_contact)
),
n_contacts=rep(0,  nrow(id_no_contact)*length(locations))
)
) %>%
# joining w/ participant's age
left_join(india_participant %>% select(id, participant_age),
by = "id"
)
## Number of contacts of the same age group, individual-level
same.age.grp_count <-
data %>%
mutate(same.age.grp = ifelse(participant_age == contact_age, 1, 0)
) %>%
mutate(
same.age.grp_1 = case_when(
contact_location %in% c("Home", "Work","School") ~  same.age.grp, # for these layers, a replicated contact is counted as unique contact
contact_location %in% c("Nonhome" ) & fromdayone == "Both days" ~ same.age.grp*2, # for non-home layer, a replicated contact is counted as two contact
contact_location %in% c("Nonhome" ) & fromdayone %in% c("Day 1", "Day 2") ~ same.age.grp, # for non-home layer, a unique contact is counted as one contact
T ~ same.age.grp # for observation with fromdayone information missed, we return the original same.age.grp
)
) %>%
select(id,  contact_location, same.age.grp_1,  contact_age) %>%
rbind(.,
data.frame(
id = rep(as.character(id_no_contact$id), each = length(locations)),
contact_location= rep(locations,
nrow(id_no_contact)
),
same.age.grp_1=rep(0,  nrow(id_no_contact)*length(locations)),
contact_age =NA
)
)%>%
# joining w/ participant's age
left_join(india_participant %>% select(id, participant_age),
by = "id"
)
out <-list(contact_count, same.age.grp_count); names(out) <- c("contact_count", "sameage.grp.count")
out
}
contact_count_rural <- contact_freq(data=india_mix.rural.6age.grps$india_mix.rural.6age.grps,
site = "Rural",
india_participant = india_participant ,
india_contact = india_contact)
contact_count_urban <- contact_freq(data=india_mix.urban.6age.grps$india_mix.urban.6age.grps,
site = "Urban",
india_participant = india_participant ,
india_contact = india_contact)
contact_count_rural$sameage.grp.count %>% View()
# Fit contact_count to glm
output <- list()
## Edges
fit_edge <-
contact_count_rural$contact_count %>%
glm(n_contacts~ -1+contact_location, data=., family = poisson) %>% summary() # coefficient for two-day contact rate
fit_edge <- (fit_edge$coefficients%>% as.data.frame() %>% select(Estimate) %>% exp())/2 # the two is averaging two-day's contact rate to one-day
output[[1]] <- fit_edge
## nodefactor age.grp
nf_dat_pred <-
data.frame(
participant_age=
contact_count_rural$contact_count$participant_age %>% levels()
)
nf <- data.frame() #matrix(NA, nrow = length(locations), ncol = length(levels(contact_count$participant_age)))
for (i in 1:4 #length(locations)
) {
fit_nf_single <-
contact_count_rural$contact_count %>% filter(contact_location == levels(contact_count_rural$contact_count$contact_location)[i]) %>%
glm(n_contacts~ -1+participant_age, data=., family = poisson) # coefficient for two-day contact rate
nf_single <- fit_nf_single$coefficients %>% exp()/2 # the two is averaging two-day's contact rate to one-day
nf <-
rbind(nf, nf_single)
#     y_link_nf <-
#   predict(fit_nf,
#           newdata = nf_dat_pred,
#           type = "link",
#           se.fit = T
#          )
#  y <- exp(y_link$fit)
#   y_up <- exp(y_link$fit+1.96*y_link$se)
# y_low <- exp(y_link$fit-1.96*y_link$se)
}
nf_dat_pred$participant_age
colnames(nf) <- contact_count_rural$contact_count$participant_age %>% levels()
row.names(nf) <- levels(contact_count_rural$contact_count$contact_location)
nf
# table for 9/18 meeting
plot_deg <-
rbind(
fit_edge %>% round(2) %>% t() %>% as.numeric(),
nf %>% round(2) %>% t()
) %>% data.frame()%>% rownames_to_column()
plot_deg[1,1] <- "Overall"
plot_deg <-
plot_deg %>% rename(Group=rowname)
## nodematch age.grp
### average matched degree across age groups
contact_count_rural$sameage.grp.count %>% group_by(participant_age) %>%
summarize(mean(same.age.grp_1)/2
)
fit_nm <- glm(same.age.grp_1 ~ -1+ participant_age,
data = contact_count_rural$sameage.grp.count, family = poisson
)
predict(fit_nm, newdata = nf_dat_pred, type = "response")/2 # %>% mean()
### average matched degree regardless of age groups
mean(data$same.age.grp)
fit_nm_1 <- glm(same.age.grp ~ 1,
data = data, family = binomial()
)
