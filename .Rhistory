india_mix %>% filter(study_site == "Urban"  & contact_location == "School" & participant_age %in% c("40-69y", "60+y")
)
india_mix %>% filter(study_site == "Urban"  & contact_location == "Work" & participant_age %in% c("0-9y")
)
