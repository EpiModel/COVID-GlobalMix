# Function to conduction bivariate Poisson regression for associations of degree between layers
assoc_btw_layers <- function(contact_count_wide, category_type, output_type){
output_model <-   list()
# Create degree category - binarized, or ordinal
if(category_type != "binary"){
# With the degree distribution, the degree can be categorized into the categories of 0, 1-2, 3-5, and 6+.
contact_count_wide <-
contact_count_wide %>% mutate(
Nonhome_cat = case_when(Nonhome==0 ~ "0",
Nonhome %in% c(1:2) ~ "1-2",
Nonhome %in% c(3:5) ~ "3-5",
Nonhome >=6 ~ "6+"),
Nonhome_cat = factor( Nonhome_cat),
Home_cat = case_when(Home==0 ~ "0",
Home %in% c(1:2) ~ "1-2",
Home %in% c(3:5) ~ "3-5",
Home >=6 ~ "6+"),
Home_cat = factor( Home_cat),
School_cat = case_when(School==0 ~ "0",
School %in% c(1:2) ~ "1-2",
School %in% c(3:5) ~ "3-5",
School >=6 ~ "6+"),
School_cat = factor( School_cat),
Work_cat = case_when(Work==0 ~ "0",
Work %in% c(1:2) ~ "1-2",
Work %in% c(3:5) ~ "3-5",
Work >=6 ~ "6+"),
Work_cat = factor( Work_cat)
)
} else{ # binarized coefficient
contact_count_wide <-
contact_count_wide %>% mutate(
Nonhome_cat = case_when(Nonhome==0 ~ 0,
Nonhome >0 ~ 1),
Nonhome_cat = factor( Nonhome_cat),
Home_cat = case_when(Home==0 ~ 0,
Home >0 ~ 1),
Home_cat = factor( Home_cat),
School_cat = case_when(School==0 ~ 0,
School >0 ~ 1),
School_cat = factor( School_cat),
Work_cat = case_when(Work==0 ~ 0,
Work >0 ~ 1),
Work_cat = factor( Work_cat)
)
}
# Effects of other layers on home
output_model[[1]] <-
contact_count_wide %>%
glm(Home~ Work_cat, data=., family = poisson(link=log))
output_model[[2]] <-
contact_count_wide %>%
glm(Home~ Nonhome_cat, data=., family = poisson(link=log))
output_model[[3]] <-
contact_count_wide %>%
glm(Home~ School_cat, data=., family = poisson(link=log))
# Effects of other layers on Nonhome
output_model[[4]] <-
contact_count_wide %>%
glm(Nonhome~ Home_cat, data=., family = poisson(link=log))
output_model[[5]] <-
contact_count_wide %>%
glm(Nonhome~ School_cat , data=., family = poisson(link=log))
output_model[[6]] <-
contact_count_wide %>%
glm(Nonhome~ Work_cat , data=., family = poisson(link=log))
# Effects of other layers on School
output_model[[7]] <-
contact_count_wide %>%
glm(School~ Home_cat, data=., family = poisson(link=log))
output_model[[8]] <-
contact_count_wide %>%
glm(School~ Nonhome_cat , data=., family = poisson(link=log))
output_model[[9]] <-
contact_count_wide %>%
glm(School~ Work_cat , data=., family = poisson(link=log))
# Effects of other layers on work
output_model[[10]] <-
contact_count_wide %>%
glm(Work~ Home_cat, data=., family = poisson(link=log))
output_model[[11]] <-
contact_count_wide %>%
glm(Work~ School_cat , data=., family = poisson(link=log))
output_model[[12]] <-
contact_count_wide %>%
glm(Work~ Nonhome_cat , data=., family = poisson(link=log))
names(output_model) <- c(  "h_w", "h_nh", "h_s",  "nh_h", "nh_s", "nh_w", "s_h", "s_nh", "s_w", "w_h", "w_s", "w_nh")
if (output_type == "summary"){
output_model_summary <- rbind(c("h", rep(NA,3)),
summary(output_model[[1]])$coefficients %>% round(.,2),  summary(output_model[[2]])$coefficients %>% round(.,2) ,  summary(output_model[[3]])$coefficients %>% round(.,2)  ,
c("nh", rep(NA,3)),
summary(output_model[[4]])$coefficients %>% round(.,2) ,  summary(output_model[[5]])$coefficients %>% round(.,2) , summary(output_model[[6]])$coefficients %>% round(.,2) ,
c("s", rep(NA,3)),
summary(output_model[[7]])$coefficients %>% round(.,2) ,  summary(output_model[[8]])$coefficients %>% round(.,2) ,  summary(output_model[[9]])$coefficients %>% round(.,2) ,
c("w", rep(NA,3)),
summary(output_model[[10]])$coefficients %>% round(.,2) ,  summary(output_model[[11]])$coefficients %>% round(.,2) ,  summary(output_model[[12]])$coefficients %>% round(.,2) )
} else if (output_type == "model") {
output_model
} else if (output_type == "data") { # categorized data
contact_count_wide
}
}
# Rural, Bivariate predictors, assessing association between layers
layer_rural_assoc_bi <-
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "model")
layer_rural_assoc_bi_summary <-
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "summary")
layer_rural_assoc_bi_summary[-c(2,4,6, 9,11,13, 16, 18, 20, 23, 25, 27),]
## Effect of the work layer on home layer
#### The following script is adapted from "NetParams.R" in ARTnet
h_w <- predict(layer_rural_assoc_bi$h_w, newdata = data.frame(Work_cat = factor(1) # characterize the MD of home explained by work contact
),
type = "response", interval = "confidence") %>% as.numeric()/2 # we add 2 here to covert the two-day MD to single-day MD
## effect of the work and non-home layers on home layer
###Given the non home layer is also significant, we use a multivariate model to adjust for the effects of work and nonhome on home
layer_rural_assoc_h_w_nh <-
layer_rural_assoc_bi_data %>%
glm(Home~ Work_cat + Nonhome_cat, data=., family = poisson(link=log)
)
layer_rural_assoc_h_w_nh %>% summary() # both layer predictors are significant and negative in the multivariate model
#### characterize the MD of home explained by work and nonhome contacts
h_w_nh <-  predict(layer_rural_assoc_h_w_nh,
newdata = data.frame(Work_cat = factor(1),
Nonhome_cat = factor(1)
),
type = "response", interval = "confidence") %>% as.numeric()/2
#### compare h_w and h_w_nh to the observed overall MD at home
network_stats_rural$edge %>% filter(contact_location == "Home") ; h_w; h_w_nh # as expected, the MD adjusting for the two other layers is lower.
## Effect of the work layer on home layer
#### The following script is adapted from "NetParams.R" in ARTnet
h_w <- predict(layer_rural_assoc_bi$h_w, newdata = data.frame(Work_cat = factor(1) # characterize the MD of home explained by work contact
),
type = "response", interval = "confidence") %>% as.numeric()/2 # we add 2 here to covert the two-day MD to single-day MD
## effect of the work and non-home layers on home layer
###Given the non home layer is also significant, we use a multivariate model to adjust for the effects of work and nonhome on home
layer_rural_assoc_h_w_nh <-
layer_rural_assoc_bi_data %>%
glm(Home~ Work_cat + Nonhome_cat, data=., family = poisson(link=log)
)
## effect of the work and non-home layers on home layer
###Given the non home layer is also significant, we use a multivariate model to adjust for the effects of work and nonhome on home
layer_rural_assoc_bi_data <-
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "data")
layer_rural_assoc_h_w_nh <-
layer_rural_assoc_bi_data %>%
glm(Home~ Work_cat + Nonhome_cat, data=., family = poisson(link=log)
)
layer_rural_assoc_h_w_nh %>% summary() # both layer predictors are significant and negative in the multivariate model
layer_rural_assoc_h_w_nh %>% summary() # both layer predictors are significant and negative in the multivariate model
layer_rural_assoc_bi_summary[-c(2,4,6, 9,11,13, 16, 18, 20, 23, 25, 27),]
h_w
## effect of the work and non-home layers on home layer
###Given the non home layer is also significant, we use a multivariate model to adjust for the effects of work and nonhome on home
layer_rural_assoc_bi_data <-
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "binary", output_type = "data")
layer_rural_assoc_h_w_nh <-
layer_rural_assoc_bi_data %>%
glm(Home~ Work_cat + Nonhome_cat, data=., family = poisson(link=log)
)
layer_rural_assoc_h_w_nh %>% summary() # both layer predictors are significant and negative in the multivariate model
#### characterize the MD of home explained by work and nonhome contacts
h_w_nh <-  predict(layer_rural_assoc_h_w_nh,
newdata = data.frame(Work_cat = factor(1),
Nonhome_cat = factor(1)
),
type = "response", interval = "confidence") %>% as.numeric()/2
#### compare h_w and h_w_nh to the observed overall MD at home
network_stats_rural$edge %>% filter(contact_location == "Home") ; h_w; h_w_nh # as expected, the MD adjusting for the two other layers is lower.
# Multivariate predictors
layer_rural_assoc_multi  <-
assoc_btw_layers(contact_count_wide = contact_count_wide_rural, category_type = "nonbinary", output_type = "summary"
)
layer_urban_assoc_multi  <-
