mix_prop_matrix_2d_crude[i, 6] <-  mix_status_layer_i[, (10+6*(i-1))] %>% mean()
}
output$mix_prop_matrix_2d_glm <- mix_prop_matrix_2d_glm
output$mix_prop_matrix_2d_crude <- mix_prop_matrix_2d_crude
output
}
