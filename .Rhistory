left = "Age",
bottom = "Age"
)
n_contact_location <- # number of contact location
india_mix.rural.6age.grps$india_mix.rural.6age.grps$contact_location %>% levels() %>% length()
id_no_contact <- # participants having no contact
india_participant %>%
filter(!(id %in% india_contact$id)) %>%
filter(study_site == "Rural")
# individual level degree, this does reflect data
id_p_age <- # nrow equals to 608*4, where 608 is n participant, 4 is the number of contact locations
#original <-
india_mix.rural.6age.grps$india_mix.rural.6age.grps %>%
# select(id,participant_age, fromdayone,contact_location) %>% # summarizing degree by contact location
#group_by(participant_age) %>%
# mutate(n_participants = n_distinct(id)) %>%  # total number of participants by age group
#ungroup() %>%
group_by(id,  contact_location, participant_age,  fromdayone, .drop = F) %>%
summarise(n_contacts = n()) %>%  # total number of contacts reported over the 2 study days, by contact_location, participant's age group, contact's age group, total number of participants in each age group
mutate(n_contacts = case_when(contact_location == "Home" & fromdayone == "Both days" ~ n_contacts/2, # for repeated home contacts over two days, we count them once
TRUE ~ n_contacts)
) %>%
#filter(!is.na(fromdayone)) %>% # complete case analysis for fromdayone
ungroup() %>%
group_by(id, #participant_age,
contact_location) %>%
summarise(n_contacts = sum(n_contacts)) %>% # sum all the contacts in all categories of "fromdayone" together
ungroup() %>%
# add the 4 participants w/ contact to aboave
rbind(.,
data.frame(
id = rep(as.character(id_no_contact$id), n_contact_location),
contact_location= rep(levels(india_mix$contact_location), n_contact_location),
n_contacts=rep(0,  nrow(id_no_contact)*n_contact_location)
)
)
id_p_age %>% View()
# Contact rates based on summarization
id_p_age %>% group_by(contact_location) %>% summarize(n_contacts = sum(n_contacts), # 608 *6
n_participants =n(),
frac = (n_contacts/(n_participants))/2
#frac = (n_contacts/(n/6))/2
) %>% View()
# Contact rates based on glm
fit <-
id_p_age %>% #filter(contact_location=="Home") %>%
glm(n_contacts~ -1+contact_location, data=., family = poisson) %>% summary()
fit <- (fit$coefficients%>% as.data.frame() %>% exp())/2
fit <- fit %>% rename(sd=2) %>%
mutate(lower_ci=Estimate-1.96*sd,
upper_ci=Estimate+1.96*sd)
# Contact rate based on script adopt from Corp Mix
india_mix.sum.no15$india_mix.sum.no15.rural.6age.grps %>% group_by(contact_location, participant_age, n_participants) %>% #
summarise(n_contacts = sum(n_contacts)) %>%
ungroup() %>%
group_by(contact_location) %>%
summarise(n_contacts = sum(n_contacts),
n_participants = sum(n_participants)) %>%
mutate(md = (n_contacts/n_participants)/2)
rbind(
avg.matrices.india$avg.matrix.india.rural.6age.grps$avg.matrix%>% group_by(contact_location) %>% summarize(mean(total_degree)) %>% rename(Estimate=2),
fit %>% rownames_to_column() %>% select(1,2) %>% rename(contact_location=1)
)
