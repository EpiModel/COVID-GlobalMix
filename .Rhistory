)
# Effect of non-home contact on home
glm_h_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Work_cat, data=., family = poisson(link=log)) %>% summary()
glm_h_sch <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ School_cat, data=., family = poisson(link=log))%>% summary()
glm_h_nh_sch_wk <- # For an intercept only model, the coefficient is positive in in valid so we add the intercept back
contact_count_wide %>%
glm(Home~ Nonhome_cat + School_cat + Work_cat, data=., family = poisson(link=log))%>% summary()
output[[3]] <- rbind(glm_h_wk$coefficients, NA, glm_h_sch$coefficients, NA, glm_h_nh_sch_wk$coefficients)
names(output) <- c("df", "mean_variance", "glm_results")
output
}
assoc_btw_layers(contact_count_wide = contact_count_wide_rural)
assoc_btw_layers(contact_count_wide = contact_count_wide_urban)
