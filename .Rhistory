degree_ci_all_layers <- function(avg.matrix){
degree_ci_fun <-
function(avg.matrix, contact_location.){
degree_matrix <-
avg.matrix %>% filter(contact_location == contact_location.) %>% select(`0-9y`:`60+y`) %>% as.data.frame()
degree_vec <- c()
for (i in 1:nrow(degree_matrix)) {
degree_vec <- c(degree_vec,
c(degree_matrix[i, c(1:(i-1))], degree_matrix[-c(1:(i-1)),i]) %>% unlist() %>% as.numeric()
)
}
matrix_deg <-
data.frame(
age.grp=names(degree_matrix) %>% rep(., each=6),
degree_vec
) %>% filter(!is.nan(degree_vec) ) # filter NaN value out from the dataframe
# Overall individual-level degree
lm_result_overall <- matrix_deg %>%  lm(degree_vec~1, data= .)
# Individual-level degree by age.group
lm_result_agegrp <- matrix_deg %>%  lm(degree_vec~ -1 +age.grp, data= .)
rbind(
cbind(
lm_result_overall$coefficients, # mean degree
lm_result_overall%>% confint()  # confidence interval
),
cbind(
lm_result_agegrp$coefficients, # mean degree
lm_result_agegrp%>% confint()  # confidence interval
)
) %>% data.frame() %>%
rename(pt_est=1, lower_cl = 2, upper_cl = 3)
}
layers <- c("Home", "Nonhome", "School", "Work")
degree_ci <- data_frame( rowname=c("(Intercept)",   "age.grp0-9y",   "age.grp10-19y",
"age.grp20-29y", "age.grp30-39y" ,"age.grp40-59y" ,"age.grp60+y"  )
)
for (i in 1:4) {
degree_ci_single  <-
degree_ci_fun(avg.matrix = avg.matrix,
contact_location. = layers[i])
#degree_ci_single$layer <- layers[i]
degree_ci_single <-
degree_ci_single %>% mutate(pt_est = paste0(round(pt_est, 2),
" (",
round(lower_cl,2),
",",
round(upper_cl, 2),
")"
)
) %>%
select(pt_est)  %>% rownames_to_column()
colnames(degree_ci_single)[2] <- layers[i]
degree_ci <- left_join(degree_ci, degree_ci_single, by = "rowname")
}
rownames(degree_ci)[rownames(degree_ci) == "(Intercept)"] <- "Overall"
degree_ci
}
