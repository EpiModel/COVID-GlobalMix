prop_mix_degree <-
function(mix_degree, age.grp.a, age.grp.b, contact_loc){
dir_1 <-   paste0("age.grp", age.grp.a, "_",age.grp.b) # contact direction between participant in age group a and contact in age group b
dir_2 <-   paste0("age.grp", age.grp.b, "_", age.grp.a)# contact direction between participant in age group b and contact in age group a
age_cats <-
mix_degree[[dir_1]] %>% filter(contact_location == contact_loc) %>% pull(participant_age) %>% levels()
glm_nmix_dir_1 <-
mix_degree[[dir_1]] %>% filter(contact_location == contact_loc) %>% rename_at(ncol(.), ~ "degree") %>%
glm(degree ~ -1+ participant_age,
data = ., family = "binomial"
)  %>% summary()
glm_nmix_dir_2 <-
mix_degree[[dir_2]] %>% filter(contact_location == contact_loc) %>% rename_at(ncol(.), ~ "degree") %>%
glm(degree ~ -1+ participant_age,
data = ., family = "binomial"
)  %>% summary()
mean(
glm_nmix_dir_1$coefficients %>% as.data.frame() %>% rownames_to_column(var = "age.grp") %>%
mutate(age.grp = str_replace(age.grp, "participant_age", "")) %>% filter(age.grp == age_cats[age.grp.a]) %>% pull(Estimate) %>% expit(),
glm_nmix_dir_2$coefficients %>% as.data.frame() %>% rownames_to_column(var = "age.grp") %>%
mutate(age.grp = str_replace(age.grp, "participant_age", "")) %>% filter(age.grp == age_cats[age.grp.b]) %>% pull(Estimate) %>% expit() )
}
prop_mix_degree(mix_degree = contact_count_rural$age.grp_mix_degree, age.grp.a = 1, age.grp.b = 2, contact_loc = "Home")
