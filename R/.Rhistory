md.info.urban[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Urban" , `Nonhome` ="Nonhome, Urban" )),
md.info.rural[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Rural" , `Nonhome` ="Nonhome, Rural" ))
) %>% rename(  `contact location` =contact_location, `total degree `=total_degree, ` edges in same age grp.` = within_age_edges) %>% mutate_if(is.numeric, round, 3)
)
