kable(
rbind(
md.info.urban[[2]] %>% rownames_to_column(var = "contact_location")  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Urban" , `Nonhome` ="Nonhome, Urban" )),
md.info.rural[[2]] %>% rownames_to_column(var = "contact_location")  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Rural" , `Nonhome` ="Nonhome, Rural" ))
) %>% rename(  `contact location` =contact_location) %>% mutate_if(is.numeric, round, 3)
)%>%
