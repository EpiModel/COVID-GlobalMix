install.packages("kableExtra")
library(kableExtra)
rbind(
md.info.urban[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Urban" , `Nonhome` ="Nonhome, Urban" )),
md.info.rural[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Rural" , `Nonhome` ="Nonhome, Rural" ))
) %>% rename(  `contact location` =contact_location, `tot. degree `=total_degree, ` edges, same age grp.` = within_age_edges) %>% mutate_if(is.numeric, round, 3) %>%
knitr::kable() %>%
kable_styling()
rbind(
md.info.urban[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Urban" , `Nonhome` ="Nonhome, Urban" )),
md.info.rural[[3]]  %>% mutate(contact_location=recode(contact_location,  `Home`= "Home, Rural" , `Nonhome` ="Nonhome, Rural" ))
) %>% rename(  `contact location` =contact_location, `total degree `=total_degree, `Number of edges with same age group` = within_age_edges) %>% mutate_if(is.numeric, round, 3) %>%
knitr::kable() %>%
