md.info <- function(mixing.raw, sym.matrix){ # it'd be better to organize things in list for this.
output <- list()
# mean degree by network layer (contact location)
output[[1]] <- mixing.raw %>%
group_by(contact_location,p_age,n_participants) %>%
summarise(n_contacts = sum(n_contacts)) %>% # the sum of two-day contacts
ungroup() %>%
group_by(contact_location) %>%
summarise(n_contacts = sum(n_contacts), #  total contacts over two days
n_participants = sum(n_participants)) %>%
mutate(md.daily = (n_contacts/n_participants)/2) %>% as.data.frame() # mean degree at daily scale
# total daily degree of edges per age group for nodefactor()
output[[2]] <-
rbind(
sym.matrix %>%
filter(contact_location == "Home") %>%
select(total_degree) %>%
as_vector() %>%
as.numeric(),
sym.matrix %>%
filter(contact_location == "Nonhome") %>%
select(total_degree) %>%
as_vector() %>%
as.numeric()
)
row.names(output[[2]]) <- c("Home", "Nonhome"); colnames(output[[2]]) <- levels(sym.matrix$age);
# proportion of daily within-age-group matching by contact_location
output[[3]] <- sym.matrix  %>%
mutate(within_age_edges = total_degree*prop_match) %>% # at the daily scale
select(contact_location,age,total_degree,within_age_edges) %>%
group_by(contact_location) %>%
summarise(total_degree = sum(total_degree),
within_age_edges = sum(within_age_edges)) %>%
mutate(match = within_age_edges/total_degree) %>% as.data.frame() # at the daily scale
names(output) <- c("md.layer", "md.ag", "within.ag.match.prop")
View(output[[1]])
}
