degree.proportion.age <- function(mix.sum){
ggplot(data = mix.sum,
mapping = aes(x = p_age,
y = prop_degree,
fill = contact_age)
) +
geom_bar(stat="identity")+
facet_grid(rows = vars(contact_location))+
theme_classic()+
labs(x = "Participant age", y = "Degree Proportion")+
guides(fill=guide_legend(title="Contact age")
)+ggtitle(panel_title)
}
